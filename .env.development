# Used automatically by `next dev` (overrides .env in development only).
# Keeps day-to-day navigation fast by using the local portable PostgreSQL
# (.dev\pgsql — start it with scripts\start-db.ps1) instead of the remote
# Neon database, which adds ~300ms per query from this region.
#
# Production (next build/start, Vercel) and the Prisma CLI (db:push, db:seed)
# still use DATABASE_URL from .env — currently Neon.
# To run Prisma CLI against this local database instead:
#   npx dotenv -e .env.development -- npx prisma db push   (or temporarily edit .env)
DATABASE_URL="postgresql://hotel:hotel@localhost:5433/hotel_management?schema=public"
